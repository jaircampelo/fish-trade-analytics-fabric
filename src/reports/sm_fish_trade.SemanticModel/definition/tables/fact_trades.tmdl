	measure 'PC - Subtitulo HHI' =
			
			VAR __HHIInicio =
			    CALCULATE(
			        [% HHI Pais Dinamico],
			        FILTER(
			            ALL(dim_calendar),
			            dim_calendar[ano] = MIN(dim_calendar[ano])
			        )
			    )
			
			VAR __HHIFim =
			    CALCULATE(
			        [% HHI Pais Dinamico],
			        FILTER(
			            ALL(dim_calendar),
			            dim_calendar[ano] = MAX(dim_calendar[ano])
			        )
			    )
			
			VAR __Variacao = __HHIFim - __HHIInicio
			
			VAR __AnoInicio = MIN(dim_calendar[ano])
			VAR __AnoFim = MAX(dim_calendar[ano])
			
			VAR __TextoDinamico =
			    IF(
			        __Variacao < 0,
			        "o mercado se diversificou " & FORMAT(ABS(__Variacao), "#0.0%") & " desde " & __AnoInicio,
			        "a concentração aumentou " & FORMAT(__Variacao, "#0.0%") & " desde " & __AnoInicio
			    )
			
			VAR __TextoFinal =
			    "HHI: índice de concentração de mercado (quanto maior, mais dependente de poucos parceiros) indica que "
			    & __TextoDinamico
			
			RETURN
			    __TextoFinal
		displayFolder: Medidas\07. Storytelling
		lineageTag: d6ec7084-0a6e-4efe-bb09-56d146faa7bf

