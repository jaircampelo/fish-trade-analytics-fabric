	measure 'VG - Subtitulo Produtos' =
			
			-- Busca todas as categorias
			VAR __TodasCategorias =
			ALLSELECTED(dim_categories[categoria_nome], dim_categories[categoria_id])
			
			-- Extrai o Top 1 e o Top 2 por valor de exportações
			VAR __Top1 =
			TOPN(1, __TodasCategorias, [$ Exportacoes], DESC)
			VAR __SemTop1 =
			EXCEPT(__TodasCategorias, __Top1)
			VAR __Top2 =
			TOPN(1, __SemTop1, [$ Exportacoes], DESC)
			
			-- Assegura um valor escalar para inserir no texto
			VAR __EscalarTop1Nome = CONCATENATEX(__Top1, dim_categories[categoria_nome])
			VAR __EscalarTop1Id = CONCATENATEX(__Top1, dim_categories[categoria_id])
			
			VAR __EscalarTop2Nome = CONCATENATEX(__Top2, dim_categories[categoria_nome])
			VAR __EscalarTop2Id = CONCATENATEX(__Top2, dim_categories[categoria_id])
			
			--Extrai o percentual do Top 1 e do Top 2
			VAR __Top1Percent =
			FORMAT(
			    CALCULATE(
			        [% Participacao no Total Exportacoes],
			        __Top1
			    ),
			    "#0.0%"
			)
			VAR __Top2Percent =
			FORMAT(
			    CALCULATE(
			        [% Participacao no Total Exportacoes],
			        __Top2
			    ),
			    "#0.0%"
			)
			
			VAR __Texto =
			"A categoria "
			& __EscalarTop1Nome & " (" & __EscalarTop1Id & ") domina "
			&  __Top1Percent
			& " do mercado de exportações, seguida de "
			& __EscalarTop2Nome & " (" & __EscalarTop2Id & "), com "
			& __Top2Percent & "."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: d91322f6-decc-41ce-b26e-0991707a2109

		changedProperty = DisplayFolder

		changedProperty = Name

