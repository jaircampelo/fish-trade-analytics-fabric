	measure '_Dados Disponiveis' =
			
			VAR __MinData =
			    CALCULATE(
			        MIN(fact_trades[comercio_data]),
			        ALL(fact_trades)
			    )
			VAR __MaxData =
			    CALCULATE(
			        MAX(fact_trades[comercio_data]),
			        ALL(fact_trades)
			    )
			
			RETURN
			"Dados disponíveis de "
			& FORMAT(__MinData, "mmm/yyyy")
			& " a "
			& FORMAT(__MaxData, "mmm/yyyy")
		displayFolder: Medidas\07. Storytelling
		lineageTag: a20f0696-f947-477d-b247-a3822a715e85

		changedProperty = DisplayFolder

		changedProperty = Name

