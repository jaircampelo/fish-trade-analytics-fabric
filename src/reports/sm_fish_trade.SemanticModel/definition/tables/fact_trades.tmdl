	measure 'VG - Subtitulo Top N Paises' = ```
			
			------------------------------------------
			-- CALCULANDO VALORES
			------------------------------------------
			VAR __Pais =
			TOPN(
			    1,
			    ALLSELECTED(dim_countries[pais_nome]),
			    [$ Exportacoes], DESC
			)
			VAR __Valor =
			CALCULATE(
			    [$ Exportacoes],
			    __Pais
			)
			VAR __FormatValor =
			formatar_numero(__Valor)
			VAR __Pct =
			CALCULATE(
			    [% Participacao no Total Exportacoes],
			    __Pais
			)
			
			------------------------------------------
			-- CALCULANDO RANGE DE DATAS
			------------------------------------------
			VAR __Data =
			ALLSELECTED(dim_calendar[mes_ano_nome], dim_calendar[mes_ano_numero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MinNumero), 
			    dim_calendar[mes_ano_nome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MaxNumero), 
			    dim_calendar[mes_ano_nome]
			)
			
			VAR __Texto =
			__Pais
			& " lidera as exportações brasileiras de pescado, absorvendo " 
			& FORMAT(__Pct, "0.0%")
			& " do total, equivalente a U$ " 
			& __FormatValor
			& " durante o período de "
			& __MinNome & " - " & __MaxNome
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: 27db10e7-1124-4294-a8f6-9d6c6928e253

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'VG - Subtitulo Visual Serie Historica' = ```
			
			VAR __MaxImp =
			MAXX(
			    ALL(dim_calendar[mes_ano_nome]),
			    [$ Importacoes]
			)
			
			VAR __MaxData = 
			TOPN(
			    1,
			    ALL(dim_calendar[mes_ano_nome]),
			    [$ Importacoes], DESC
			)
			VAR __MaxDataEscalar =
			CONCATENATEX(__MaxData, dim_calendar[mes_ano_nome])
			
			VAR __FormatMax =
			formatar_numero(__MaxDataEscalar)
			
			VAR __Texto =
			"O Brasil se destaca como um importador líquido de pescado, atingindo a máxima histórica de "
			& __FormatMax
			& " de dólares em "
			& __MaxDataEscalar
			
			RETURN
			__Texto
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: 5c677d78-d8b9-4d16-940c-b40202ce759b

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'VG - Titulo Top N Estados' =
			
			VAR __TopNValor = [aux_topn Value]
			
			VAR __TextoTop1 =
			"Quem é o Top 1 estado que mais exporta?"
			
			VAR __TextoTopMaiorQue1 =
			"Quem são os Top "
			& __TopNValor
			& " estados que mais exportam?"
			
			VAR __Texto =
			IF(
			    __TopNValor > 1,
			    __TextoTopMaiorQue1,
			    __TextoTop1
			)
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: 1b52fb57-fcde-406a-a68c-bb5c7d26e27c

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'VG - Titulo Top N Paises' =
			
			VAR __TopNValor = [aux_topn Value]
			
			VAR __TextoTop1 =
			"Quem é o principal parceiro comercial do Brasil nas exportações?"
			
			VAR __TextoTopMaiorQue1 =
			"Quem são os Top "
			& __TopNValor
			& " parceiros comerciais do Brasil nas exportações?"
			
			VAR __Texto =
			IF(
			    __TopNValor > 1,
			    __TextoTopMaiorQue1,
			    __TextoTop1
			)
			
			RETURN
			__Texto
