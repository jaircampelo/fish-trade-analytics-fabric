			    TRUE(),
			    __QtdSelecionadas = COUNTROWS(ALL(dim_categories[categoria_nome])),
			        "Destino de " & FORMAT(__Top1Pct, "#0.00%") & " de tudo que o Brasil exporta em pescado",
			    __QtdSelecionadas = 1,
			        "Destino de " & FORMAT(__Top1Pct, "#0.00%") & " de tudo que o Brasil exporta em " & __UmaCategoria,
			    "Destino de " & FORMAT(__Top1Pct, "#0.00%") & " de tudo que o Brasil exporta para as categorias selecionadas"
