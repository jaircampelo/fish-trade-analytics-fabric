	measure 'B - Subtitulo Card Exportacoes' = ```
			
			VAR __MaiorEstadoTab =
			    INDEX(
			        1,
			        ALLSELECTED(dim_cities[estado_nome]),
			        ORDERBY([$ Exportacoes], DESC)
			    )
			VAR __MaiorEstadoNome =
			    CONCATENATEX(__MaiorEstadoTab, dim_cities[estado_nome])
			VAR __TabMaiorEstadoComValor =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_cities[estado_nome]),
			        "@Valor",
			        [$ Exportacoes],
			        "@Peso",
			        [# Peso Líquido Exportacoes]
			    )
			VAR __MaiorEstadoValor =
			    MAXX(
			        TOPN(1, __TabMaiorEstadoComValor, [@Valor], DESC),
			        [@Valor]
			    )
			VAR __FormatMaiorEstadoValor =
			    formatar_numero(__MaiorEstadoValor)
			VAR __MaiorEstadoPeso =
			    MAXX(
			        TOPN(1, __TabMaiorEstadoComValor, [@Peso], DESC),
			        [@Peso]
			    )
			VAR __FormatMaiorEstadoPeso =
			    SWITCH(
			        TRUE(),
			        ABS(__MaiorEstadoPeso) >= 1000, FORMAT(__MaiorEstadoPeso, "#,#0,.00 Ton"),
			        FORMAT(__MaiorEstadoPeso, "#0 Kg")
			    )
			
			VAR __Data =
			ALLSELECTED(dim_calendar[mes_ano_nome], dim_calendar[mes_ano_numero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MinNumero), 
			    dim_calendar[mes_ano_nome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MaxNumero), 
			    dim_calendar[mes_ano_nome]
			)
			
			VAR __Texto =
			    "Foi o estado que mais exportou pescado no período de "
			    & __MinNome & " - " & __MaxNome
			    & ", acumulando o valor de "
			    & __FormatMaiorEstadoValor
			    & " de dólares e um volume total de "
			    & __FormatMaiorEstadoPeso & "."
			RETURN
			__Texto
			```
