	measure 'P - Subtitulo Importacoes por Categoria' = ```
			
			-- CRIA UMA TABELA MOSTRANDO A TOP 1 CATEGORIA DE CADA ANO NAS EXPORTAÇÕES
			VAR __TabTop1Anos =
			ADDCOLUMNS(
			    ALLSELECTED(dim_calendar[ano]),
			    "@Top1Cat",
			    CONCATENATEX(
			        TOPN(
			            1,
			            ALLSELECTED(dim_categories[categoria_nome]),
			            [$ Importacoes], DESC
			        ),
			        dim_categories[categoria_nome]
			    )
			)
			
			-- RETORNA O LÍDER DE COMÉRCIO NO ANO MAIS RECENTE
			VAR __AnoMaisRecente =
			MAXX(__TabTop1Anos, dim_calendar[ano])
			VAR __Top1CatRecente =
			MAXX(
			    FILTER(__TabTop1Anos, dim_calendar[ano] = __AnoMaisRecente),
			    [@Top1Cat]
			)
			
			-- RETORNA A QUANTO TEMPO O LÍDER MAIS RECENTE ESTÁ NO TOPO
			VAR __AnoMaisRecenteSemTop1 =
			MAXX(
			    FILTER(__TabTop1Anos, [@Top1Cat] <> __Top1CatRecente),
			    dim_calendar[ano]
			)
			VAR __PeriodoLideranca =
			__AnoMaisRecente - __AnoMaisRecenteSemTop1
			
			-- RETORNA O VALOR DO COMÉRCIO ACUMULADO DO TOP 1 MAIS RECENTE
			VAR __Acc =
			CALCULATE(
			    [$ Importacoes Acc],
			    FILTER(
			        dim_categories,
			        dim_categories[categoria_nome] = __Top1CatRecente
			    )
			)
			VAR __FormatAcc =
			formatar_numero(__Acc)
			
			-- RETORNA A DATA MÍNIMA E MÁXIMA DO PERÍODO SELECIONADO NOS FILTROS
			VAR __Data =
			ALLSELECTED(dim_calendar[mes_ano_nome], dim_calendar[mes_ano_numero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Importacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Importacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MinNumero), 
			    dim_calendar[mes_ano_nome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MaxNumero), 
			    dim_calendar[mes_ano_nome]
			)
			
			RETURN
			__Top1CatRecente
			& " lideram as importações há "
			& __PeriodoLideranca
			& " anos consecutivos e acumularam "
			& __FormatAcc
			& " entre "
			& __MinNome & " - " & __MaxNome & "."
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: dd11b975-4e49-4bde-b7a7-465c54ffaed0

