	measure '% Participacao no Total Exportacoes' =
			
			VAR __Total =
			CALCULATE(
			    [$ Exportacoes],
			    ALL(fact_trades)
			)
			
			VAR __Result = DIVIDE([$ Exportacoes], __Total)
			
			RETURN
			__Result
		displayFolder: Medidas\03. Performance & Preço
		lineageTag: e6f374ad-c436-4b14-a127-7803bdcf9c56

		changedProperty = DisplayFolder

		changedProperty = Name

