		changedProperty = Name

	measure 'PC - Subtitulo Tornado' = ```
			
			----------------------------------
			-- MEDIDAS PARA EXPORTAÇÕES
			----------------------------------
			VAR __TopExpTab =
			    INDEX(
			        1,
			        ALLSELECTED(dim_countries[pais_nome]),
			        ORDERBY([$ Exportacoes], DESC)
			    )
			
			VAR __TopExpNome =
			    SELECTCOLUMNS(__TopExpTab, "@Nome", dim_countries[pais_nome])
			
			VAR __TabExpComPct =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_countries[pais_nome]),
			        "@Pct",
			        CALCULATE([% Participacao no Total Exportacoes])
			    )
			
			VAR __TopExpPct = 
			    MAXX(
			        TOPN(1, __TabExpComPct, [@Pct], DESC),
			        [@Pct]
			    )
			    
			----------------------------------
			-- MEDIDAS PARA IMPORTAÇÕES
			----------------------------------
			VAR __TopImpTab =
			    INDEX(
			        1,
			        ALLSELECTED(dim_countries[pais_nome]),
			        ORDERBY([$ Importacoes], DESC)
			    )
			
			VAR __TopImpNome =
			    SELECTCOLUMNS(__TopImpTab, "@Nome", dim_countries[pais_nome])
			
			VAR __TabImpComPct =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_countries[pais_nome]),
			        "@Pct",
			        CALCULATE([% Participacao no Total Importacoes])
			    )
			
			VAR __TopImpPct = 
			    MAXX(
			        TOPN(1, __TabImpComPct, [@Pct], DESC),
			        [@Pct]
			    )
			
			VAR __N = [aux_topn Value]
			VAR __Texto =
			    "Top " & __N & " parceiros — " 
			    & __TopExpNome & " lidera as exportações (" & FORMAT(__TopExpPct, "0,0%") & ") "
			    & "e " & __TopImpNome & " as importações (" & FORMAT(__TopImpPct, "0,0%") & ")"
			
			RETURN
			__Texto
			```
