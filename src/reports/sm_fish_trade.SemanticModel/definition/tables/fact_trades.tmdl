	measure 'VG - Rotulo Taxa de Cobertura YoY' =
			
			VAR __Variacao = [p.p. Taxa de Cobertura YoY]
			
			VAR __Result =
			SWITCH(
			    TRUE(),
			    __Variacao > 0, FORMAT(__Variacao, "+0.0") & " p.p.",
			    __Variacao < 0, FORMAT(__Variacao, "-0.0") & " p.p.",
			    FORMAT(__Variacao, "0.0") & " p.p."
			)
			
			RETURN
			__Result
