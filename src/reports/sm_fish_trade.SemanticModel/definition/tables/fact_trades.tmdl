	measure 'BC - Subtitulo Nominal vs Real' =
			
			VAR __TodosMeses = ALLSELECTED(dim_calendar[mes_ano_nome], dim_calendar[mes_ano_numero])
			
			VAR __TopDiffValor =
			MAXX(
			    FILTER(__TodosMeses, [$ Balança Comercial Real]),
			    ABS([$ Balança Comercial Real] - [$ Balanca Comercial])
			)
			VAR __FormatTopDiffValor =
			formatar_numero(__TopDiffValor)
			
			VAR __TopDiffMes =
			MAXX(
			    FILTER(__TodosMeses, ABS([$ Balança Comercial Real] - [$ Balanca Comercial]) = __TopDiffValor),
			    dim_calendar[mes_ano_nome]
			)
			
			VAR __Texto =
			"Ao comparar o valor nominal da balança comercial com o valor corrigido pela CPI (Consumer Price Index), verificamos que a maior distorção entre o valor nominal e o real foi de "
			& __FormatTopDiffValor
			& " de dólares em "
			& __TopDiffMes & "."
			
			RETURN
			__Texto
		displayFolder: Medidas\07. Storytelling
		lineageTag: b4d263f5-0990-4ffc-a030-6a205c89f257

