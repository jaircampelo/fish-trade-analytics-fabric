	measure 'BC - Subtitulo Acumulado' = ```
			
			VAR __TodosAnos = ALLSELECTED(dim_calendar[ano])
			
			VAR __TradeDiff =
			CALCULATE(
			    ABS([$ Exportacoes Acc] - [$ Importacoes Acc]),
			    __TodosAnos
			)
			VAR __FormatTradeDiff =
			formatar_numero(__TradeDiff)
			
			VAR __Data =
			ALLSELECTED(dim_calendar[mes_ano_nome], dim_calendar[mes_ano_numero])
			VAR __MinNumero = 
			MINX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MaxNumero = 
			MAXX(
			    FILTER(__Data, [$ Exportacoes] > 0), 
			    dim_calendar[mes_ano_numero]
			)
			VAR __MinNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MinNumero), 
			    dim_calendar[mes_ano_nome]
			)
			VAR __MaxNome = 
			MAXX(
			    FILTER(__Data, dim_calendar[mes_ano_numero] = __MaxNumero), 
			    dim_calendar[mes_ano_nome]
			)
			
			VAR __TextoDeficit =
			"Para o peíodo de "
			& __MinNome & " - " & __MaxNome
			& ", o Brasil possui um déficit acumulado de "
			& __FormatTradeDiff & " de dólares."
			VAR __TextoSuperavit =
			"Para o peíodo de "
			& __MinNome & " - " & __MaxNome
			& ", o Brasil possui um superávit acumulado de "
			& __FormatTradeDiff & " de dólares."
			
			RETURN
			IF(
			    [$ Exportacoes Acc] > [$ Importacoes Acc],
			    __TextoSuperavit,
			    __TextoDeficit
			)
			```
		displayFolder: Medidas\07. Storytelling
		lineageTag: 116c5b68-524b-48ae-b524-257bcf4f028c

